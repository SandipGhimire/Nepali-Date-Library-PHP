{
    "name": "sghimire/nepali-date-library",
    "description": "Fast, zero-dependency Nepali Date (Bikram Sambat / BS) converter and calendar library for PHP. Bidirectional BS to AD / AD to BS conversion, fiscal year, date arithmetic, and Devanagari formatting.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://nepali-pkg.date/docs/php",
    "keywords": [
        "date-converter",
        "nepali-date-converter",
        "nepali-date",
        "nepali-date-library",
        "bikram-sambat",
        "bikram-sambat-date",
        "bikram-sambat-converter",
        "bs-to-ad",
        "ad-to-bs",
        "bs-date",
        "nepali-calendar",
        "nepali-patro",
        "nepali-miti",
        "nepali-age-calculator",
        "nepali-fiscal-year",
        "aarthik-barsha",
        "laravel-nepali-date",
        "php-nepali-date",
        "nepali",
        "nepal",
        "php"
    ],
    "authors": [
        {
            "name": "Sandip Ghimire",
            "email": "sandipghimire2076@gmail.com"
        }
    ],
    "support": {
        "docs": "https://nepali-pkg.date/docs/php",
        "issues": "https://github.com/SandipGhimire/Nepali-Date-Library-PHP/issues",
        "source": "https://github.com/SandipGhimire/Nepali-Date-Library-PHP"
    },
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.6 || ^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "NepaliDateLibrary\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NepaliDateLibrary\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-filter=src"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
