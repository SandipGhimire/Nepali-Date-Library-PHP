{
    "name": "sghimire/nepali-date-library",
    "description": "A Nepali Date Library for PHP (Bikram Sambat ↔ AD conversion, formatting, and manipulation)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://nepalidate.sandip-ghimire.com.np",
    "keywords": [
        "nepali",
        "nepal",
        "nepali-date-library",
        "nepali-calendar",
        "nepali-date",
        "bikram-sambat",
        "bikram-sambat-date",
        "bs-date",
        "date-conversion",
        "nepali-date-converter",
        "date-converter",
        "ad-bs",
        "ad-to-bs",
        "bs-to-ad",
        "php"
    ],
    "authors": [
        {
            "name": "Sandip Ghimire",
            "email": "sandipghimire2076@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/SandipGhimire/Nepali-Date-Library-PHP/issues",
        "source": "https://github.com/SandipGhimire/Nepali-Date-Library-PHP"
    },
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.6 || ^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "NepaliDateLibrary\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NepaliDateLibrary\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-filter=src"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
